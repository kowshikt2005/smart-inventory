# Database - Railway MySQL
DATABASE_URL="mysql://user:password@host:port/database"

# NextAuth.js Configuration
NEXTAUTH_URL="http://your-ec2-public-ip:3000"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"

# SMS Provider: "dev" (console log), "twilio", or "sns" (AWS SNS)
SMS_PROVIDER="dev"

# Twilio (only needed if SMS_PROVIDER="twilio")
TWILIO_ACCOUNT_SID="your-twilio-account-sid"
TWILIO_AUTH_TOKEN="your-twilio-auth-token"
TWILIO_PHONE_NUMBER="+1234567890"

# AWS SNS (only needed if SMS_PROVIDER="sns")
AWS_ACCESS_KEY_ID="your-aws-access-key"
AWS_SECRET_ACCESS_KEY="your-aws-secret-key"
AWS_REGION="ap-south-1"
AWS_SNS_SENDER_ID="YOURID"

# Redis (for OTP storage)
REDIS_HOST="127.0.0.1"
REDIS_PORT="6379"

# Email (SMTP) — for Email Report feature
SMTP_HOST=smtp.gmail.com    
SMTP_PORT=587                                                             SMTP_PORT=587                                                                         
SMTP_SECURE=false 
