// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ============================================
// ENUMS
// ============================================

enum UserRole {
  SALESMAN
  BILLING_OPERATOR
  ACCOUNTANT
  MANAGER
  ADMIN
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
}

enum SalesOrderStatus {
  OPEN
  HOLD
  REJECTED
}

enum StockMovementType {
  PURCHASE
  SALE
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  RETURN
  DAMAGE
  TRANSFER
}

enum PaymentStatus {
  PENDING
  PARTIAL
  PAID
  OVERDUE
  CANCELLED
}

enum LedgerEntryType {
  OPENING_BALANCE
  SALES_INVOICE
  SALES_RECEIPT
  SALES_RETURN
  ADJUSTMENT
}

enum SalesReturnStatus {
  OPEN
  COMPLETED
  CANCELLED
}

enum PaymentMode {
  CASH
  BANK_TRANSFER
  CHEQUE
  UPI
  CARD
  OTHER
}

// ============================================
// USER MANAGEMENT
// ============================================

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String
  password  String
  googleId  String?  @unique // For Google OAuth linking
  role      UserRole @default(SALESMAN)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  salesOrders       SalesOrder[]
  stockJournals     StockJournal[]
  orderStatusHistory OrderStatusHistory[]

  @@map("users")
}

// ============================================
// CUSTOMER MANAGEMENT
// ============================================

model Customer {
  id             String         @id @default(uuid())
  customerNumber String         @unique // customer-xxxx
  name           String
  gstin          String?        @db.VarChar(15) // 15-digit GST number
  email          String?
  phone          String?
  address        String?        @db.Text
  city           String?
  state          String?
  pincode        String?
  creditLimit    Decimal        @default(0) @db.Decimal(15, 2)
  creditDays     Int            @default(0)
  openingBalance Decimal        @default(0) @db.Decimal(15, 2)
  status         CustomerStatus @default(ACTIVE)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  // Relations
  salesOrders   SalesOrder[]
  invoices      Invoice[]
  payments      Payment[]
  rateSheet     RateSheet?        // One rate sheet per customer
  salesReturns  SalesReturn[]
  ledgerEntries CustomerLedger[]

  @@index([customerNumber])
  @@index([gstin])
  @@map("customers")
}

// ============================================
// CUSTOMER LEDGER (Financial Tracking)
// ============================================

model CustomerLedger {
  id            String          @id @default(uuid())
  customerId    String
  date          DateTime
  description   String
  type          LedgerEntryType
  debit         Decimal         @default(0) @db.Decimal(15, 2)
  credit        Decimal         @default(0) @db.Decimal(15, 2)
  balance       Decimal         @default(0) @db.Decimal(15, 2)
  referenceType String          // 'sales_invoice', 'sales_receipt', 'sales_return'
  referenceId   String
  createdAt     DateTime        @default(now())

  // Relations
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([date])
  @@index([type])
  @@index([referenceType, referenceId])
  @@map("customer_ledger")
}

// ============================================
// VENDOR/SUPPLIER MANAGEMENT
// ============================================

model Vendor {
  id             String   @id @default(uuid())
  vendorNumber   String   @unique // vendor-xxxx
  name           String
  gstin          String?  @db.VarChar(15)
  email          String?
  phone          String?
  address        String?  @db.Text
  city           String?
  state          String?
  pincode        String?
  creditDays     Int      @default(0)
  openingBalance Decimal  @default(0) @db.Decimal(15, 2)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  purchaseOrders PurchaseOrder[]

  @@index([vendorNumber])
  @@index([gstin])
  @@map("vendors")
}

// ============================================
// ITEM/PRODUCT MANAGEMENT
// ============================================

model Brand {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  items     Item[]
  subBrands SubBrand[]

  @@map("brands")
}

model SubBrand {
  id        String   @id @default(uuid())
  name      String
  brandId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  brand Brand  @relation(fields: [brandId], references: [id], onDelete: Cascade)
  items Item[]

  @@unique([name, brandId])
  @@index([brandId])
  @@map("sub_brands")
}

model Item {
  id            String   @id @default(uuid())
  itemCode      String   @unique // item-xxxx
  name          String
  description   String?  @db.Text
  brandId       String?
  subBrandId    String?
  hsnCode       String?  @db.VarChar(8) // HSN/SAC code for GST
  gstRate       Decimal  @default(0) @db.Decimal(5, 2) // GST percentage
  standardPrice Decimal  @default(0) @db.Decimal(15, 2)
  purchasePrice Decimal  @default(0) @db.Decimal(15, 2)
  minStock      Decimal  @default(0) @db.Decimal(15, 3)
  unit          String   @default("PCS") // PCS, KG, LTR, etc.
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  brand              Brand?              @relation(fields: [brandId], references: [id], onDelete: SetNull)
  subBrand           SubBrand?           @relation(fields: [subBrandId], references: [id], onDelete: SetNull)
  inventory          Inventory?
  salesOrderItems    SalesOrderItem[]
  invoiceItems       InvoiceItem[]
  stockMovements     StockMovement[]
  purchaseOrderItems PurchaseOrderItem[]
  salesReturnItems   SalesReturnItem[]

  @@index([itemCode])
  @@index([brandId])
  @@index([subBrandId])
  @@index([hsnCode])
  @@map("items")
}

// ============================================
// INVENTORY MANAGEMENT (Virtual Counter System)
// ============================================

model Inventory {
  id                String   @id @default(uuid())
  itemId            String   @unique
  physicalStock     Decimal  @default(0) @db.Decimal(15, 3) // Actual warehouse stock
  reservedQuantity  Decimal  @default(0) @db.Decimal(15, 3) // Reserved by sales orders
  // virtualAvailable = physicalStock - reservedQuantity (computed in application)
  minStockLevel     Decimal  @default(0) @db.Decimal(15, 3)
  lastUpdated       DateTime @updatedAt

  // Relations
  item           Item            @relation(fields: [itemId], references: [id], onDelete: Cascade)
  stockMovements StockMovement[]

  @@index([itemId])
  @@map("inventory")
}

model StockMovement {
  id            String            @id @default(uuid())
  inventoryId   String
  itemId        String
  quantity      Decimal           @db.Decimal(15, 3)
  type          StockMovementType
  referenceType String? // e.g., "SALES_ORDER", "PURCHASE_ORDER", "STOCK_JOURNAL"
  referenceId   String? // ID of the related document
  notes         String?           @db.Text
  createdAt     DateTime          @default(now())
  createdBy     String?

  // Relations
  inventory Inventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  item      Item      @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([inventoryId])
  @@index([itemId])
  @@index([referenceType, referenceId])
  @@map("stock_movements")
}

model StockJournal {
  id            String            @id @default(uuid())
  journalNumber String            @unique // SJ-xxxx
  date          DateTime
  itemId        String
  quantity      Decimal           @db.Decimal(15, 3)
  type          StockMovementType
  reason        String?           @db.Text
  createdAt     DateTime          @default(now())
  createdBy     String

  // Relations
  user User @relation(fields: [createdBy], references: [id])

  @@index([journalNumber])
  @@index([date])
  @@map("stock_journals")
}

// ============================================
// SALES ORDER MANAGEMENT (4-State Workflow)
// ============================================

model SalesOrder {
  id               String            @id @default(uuid())
  orderNumber      String            @unique // SO-xxxx
  orderDate        DateTime
  customerId       String
  expectedDelivery DateTime?
  referenceNumber  String?
  status           SalesOrderStatus  @default(OPEN)
  subtotal         Decimal           @default(0) @db.Decimal(15, 2)
  discountAmount   Decimal           @default(0) @db.Decimal(15, 2)
  taxAmount        Decimal           @default(0) @db.Decimal(15, 2)
  totalAmount      Decimal           @default(0) @db.Decimal(15, 2)
  notes            String?           @db.Text
  terms            String?           @db.Text
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  createdBy        String

  // Relations
  customer       Customer             @relation(fields: [customerId], references: [id])
  user           User                 @relation(fields: [createdBy], references: [id])
  items          SalesOrderItem[]
  invoice        Invoice?
  statusHistory  OrderStatusHistory[]

  @@index([orderNumber])
  @@index([customerId])
  @@index([status])
  @@index([orderDate])
  @@map("sales_orders")
}

model SalesOrderItem {
  id            String  @id @default(uuid())
  salesOrderId  String
  itemId        String
  quantity      Decimal @db.Decimal(15, 3)
  rate          Decimal @db.Decimal(15, 2)
  discountPercent Decimal @default(0) @db.Decimal(5, 2)
  taxRate       Decimal @default(0) @db.Decimal(5, 2)
  taxAmount     Decimal @default(0) @db.Decimal(15, 2)
  amount        Decimal @default(0) @db.Decimal(15, 2)

  // Relations
  salesOrder SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  item       Item       @relation(fields: [itemId], references: [id])

  @@index([salesOrderId])
  @@index([itemId])
  @@map("sales_order_items")
}

model OrderStatusHistory {
  id           String            @id @default(uuid())
  salesOrderId String
  fromStatus   SalesOrderStatus?
  toStatus     SalesOrderStatus
  reason       String?           @db.Text
  changedAt    DateTime          @default(now())
  changedBy    String

  // Relations
  salesOrder SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade, map: "osh_salesOrder_fkey")
  user       User       @relation(fields: [changedBy], references: [id], map: "osh_user_fkey")

  @@index([salesOrderId])
  @@index([changedAt])
  @@map("order_status_history")
}

// ============================================
// PURCHASE ORDER MANAGEMENT
// ============================================

model PurchaseOrder {
  id              String   @id @default(uuid())
  orderNumber     String   @unique // PO-xxxx
  orderDate       DateTime
  vendorId        String
  expectedDelivery DateTime?
  status          String   @default("PENDING") // PENDING, RECEIVED, PARTIAL, CANCELLED
  subtotal        Decimal  @default(0) @db.Decimal(15, 2)
  taxAmount       Decimal  @default(0) @db.Decimal(15, 2)
  totalAmount     Decimal  @default(0) @db.Decimal(15, 2)
  notes           String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  vendor Vendor              @relation(fields: [vendorId], references: [id])
  items  PurchaseOrderItem[]

  @@index([orderNumber])
  @@index([vendorId])
  @@index([orderDate])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id              String  @id @default(uuid())
  purchaseOrderId String
  itemId          String
  quantity        Decimal @db.Decimal(15, 3)
  rate            Decimal @db.Decimal(15, 2)
  taxRate         Decimal @default(0) @db.Decimal(5, 2)
  taxAmount       Decimal @default(0) @db.Decimal(15, 2)
  amount          Decimal @default(0) @db.Decimal(15, 2)

  // Relations
  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  item          Item          @relation(fields: [itemId], references: [id])

  @@index([purchaseOrderId])
  @@index([itemId])
  @@map("purchase_order_items")
}

// ============================================
// RATE SHEET MANAGEMENT (Customer-specific Pricing)
// ============================================

enum RoundOffType {
  NONE
  UP
  DOWN
  NEAREST
}

enum CurrencyType {
  INR
  USD
  EUR
  GBP
  AED
}

model RateSheet {
  id              String       @id @default(uuid())
  name            String       // Rate sheet name for reference
  customerId      String       @unique // One rate sheet per customer
  validFrom       DateTime
  validTo         DateTime?
  itemRatePercent Decimal      @default(100) @db.Decimal(5, 2) // % of base sales rate (100 = full price)
  discountPercent Decimal      @default(0) @db.Decimal(5, 2)   // Additional discount %
  excludedItemIds Json?        // Array of item IDs to exclude from this rate sheet
  currency        CurrencyType @default(INR)
  roundOff        RoundOffType @default(NONE)
  isActive        Boolean      @default(true)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  // Relations
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([validFrom, validTo])
  @@index([isActive])
  @@map("rate_sheets")
}

// ============================================
// INVOICE & PAYMENT MANAGEMENT
// ============================================

model Invoice {
  id            String        @id @default(uuid())
  invoiceNumber String        @unique // INV-xxxx
  invoiceDate   DateTime
  salesOrderId  String?       @unique // Optional - order deleted after invoice creation
  orderNumber   String?       // Stored for reference after order deletion
  customerId    String
  subtotal      Decimal       @default(0) @db.Decimal(15, 2)
  cgst          Decimal       @default(0) @db.Decimal(15, 2)
  sgst          Decimal       @default(0) @db.Decimal(15, 2)
  taxAmount     Decimal       @default(0) @db.Decimal(15, 2)
  roundOff      Decimal       @default(0) @db.Decimal(15, 2)
  totalAmount   Decimal       @default(0) @db.Decimal(15, 2)
  paidAmount    Decimal       @default(0) @db.Decimal(15, 2)
  balanceAmount Decimal       @default(0) @db.Decimal(15, 2)
  paymentStatus PaymentStatus @default(PENDING)
  dueDate       DateTime?
  notes         String?       @db.Text
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  // Relations
  salesOrder   SalesOrder?         @relation(fields: [salesOrderId], references: [id], onDelete: SetNull)
  customer     Customer            @relation(fields: [customerId], references: [id])
  items        InvoiceItem[]
  payments     Payment[]
  allocations  PaymentAllocation[]
  salesReturns SalesReturn[]

  @@index([invoiceNumber])
  @@index([customerId])
  @@index([invoiceDate])
  @@index([paymentStatus])
  @@map("invoices")
}

model InvoiceItem {
  id            String  @id @default(uuid())
  invoiceId     String
  itemId        String
  quantity      Decimal @db.Decimal(15, 3)
  rate          Decimal @db.Decimal(15, 2)
  discountPercent Decimal @default(0) @db.Decimal(5, 2)
  taxRate       Decimal @default(0) @db.Decimal(5, 2)
  taxAmount     Decimal @default(0) @db.Decimal(15, 2)
  amount        Decimal @default(0) @db.Decimal(15, 2)

  // Relations
  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  item    Item    @relation(fields: [itemId], references: [id])

  @@index([invoiceId])
  @@index([itemId])
  @@map("invoice_items")
}

model Payment {
  id              String      @id @default(uuid())
  paymentNumber   String      @unique // PAY-xxxx
  paymentDate     DateTime
  customerId      String
  invoiceId       String?     // Legacy - use allocations for new payments
  amount          Decimal     @db.Decimal(15, 2)
  mode            PaymentMode
  referenceNumber String?     // Cheque number, transaction ID, etc.
  notes           String?     @db.Text
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  // Relations
  customer    Customer            @relation(fields: [customerId], references: [id])
  invoice     Invoice?            @relation(fields: [invoiceId], references: [id])
  allocations PaymentAllocation[]

  @@index([paymentNumber])
  @@index([customerId])
  @@index([invoiceId])
  @@index([paymentDate])
  @@map("payments")
}

model PaymentAllocation {
  id        String  @id @default(uuid())
  paymentId String
  invoiceId String
  amount    Decimal @db.Decimal(15, 2)

  // Relations
  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoice Invoice @relation(fields: [invoiceId], references: [id])

  @@index([paymentId])
  @@index([invoiceId])
  @@map("payment_allocations")
}

// ============================================
// SALES RETURN (Credit Notes)
// ============================================

model SalesReturn {
  id            String            @id @default(uuid())
  returnNumber  String            @unique // SR-xxxx
  returnDate    DateTime
  customerId    String
  invoiceId     String?           // Optional - can link to original invoice
  subtotal      Decimal           @default(0) @db.Decimal(15, 2)
  cgst          Decimal           @default(0) @db.Decimal(15, 2)
  sgst          Decimal           @default(0) @db.Decimal(15, 2)
  taxAmount     Decimal           @default(0) @db.Decimal(15, 2)
  totalAmount   Decimal           @default(0) @db.Decimal(15, 2)
  reason        String?           @db.Text
  status        SalesReturnStatus @default(OPEN)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  // Relations
  customer Customer          @relation(fields: [customerId], references: [id])
  invoice  Invoice?          @relation(fields: [invoiceId], references: [id])
  items    SalesReturnItem[]

  @@index([returnNumber])
  @@index([customerId])
  @@index([invoiceId])
  @@index([status])
  @@index([returnDate])
  @@map("sales_returns")
}

model SalesReturnItem {
  id            String  @id @default(uuid())
  salesReturnId String
  itemId        String
  quantity      Decimal @db.Decimal(15, 3)
  rate          Decimal @db.Decimal(15, 2)
  taxRate       Decimal @default(0) @db.Decimal(5, 2)
  taxAmount     Decimal @default(0) @db.Decimal(15, 2)
  amount        Decimal @default(0) @db.Decimal(15, 2)

  // Relations
  salesReturn SalesReturn @relation(fields: [salesReturnId], references: [id], onDelete: Cascade)
  item        Item        @relation(fields: [itemId], references: [id])

  @@index([salesReturnId])
  @@index([itemId])
  @@map("sales_return_items")
}

// ============================================
// EMPLOYEE MANAGEMENT
// ============================================

model Employee {
  id          String   @id @default(uuid())
  employeeNumber String @unique // EMP-xxxx
  name        String
  email       String?  @unique
  phone       String?
  designation String?
  department  String?
  salary      Decimal? @db.Decimal(15, 2)
  joinDate    DateTime
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([employeeNumber])
  @@map("employees")
}

// ============================================
// BANK ACCOUNT MANAGEMENT
// ============================================

model BankAccount {
  id            String   @id @default(uuid())
  accountName   String
  accountNumber String   @unique
  bankName      String
  ifscCode      String
  branch        String?
  balance       Decimal  @default(0) @db.Decimal(15, 2)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([accountNumber])
  @@map("bank_accounts")
}