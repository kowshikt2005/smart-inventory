// ============================================
// APPLICATION SETTINGS
// ============================================

model AppSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String   @db.Text
  label     String?  // Human-readable label
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([key])
  @@map("app_settings")
}

// ============================================
// IMPORT MAPPINGS
// ============================================

model ImportMapping {
  id         String   @id @default(uuid())
  entityType String   // CUSTOMER, VENDOR, ITEM, SALES_INVOICE, PURCHASE_INVOICE, PAYMENT, VENDOR_PAYMENT, STOCK_JOURNAL
  name       String   // User-given name e.g. "Tally Customer Export"
  mapping    Json     // { "Excel Col Name": "dbFieldName", ... }
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([entityType, name])
  @@index([entityType])
  @@map("import_mappings")
}
